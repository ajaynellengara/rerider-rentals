# RideOps — Environment Configuration Template
# Database Connection (local PostgreSQL or Vercel Marketplace Postgres)
# On Vercel, set POSTGRES_URL or DATABASE_URL from the Neon Postgres integration.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/rideops"

# Authentication & Session Security (Generate with: openssl rand -base64 32)
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Set these only when running pnpm run db:seed; use unique values of 12+ characters
SEED_ADMIN_PASSWORD=""
SEED_RIDER_PASSWORD=""

# S3 / Cloudflare R2 Object Storage for KYC & Inspection Photos
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="rideops-documents"
S3_REGION="ap-south-1"

# Application Settings
NEXT_PUBLIC_APP_NAME="RideOps"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_OPERATING_CITY="Kochi, Kerala"

# Rider portal support contacts (international format, no spaces preferred)
RERIDER_SUPPORT_PHONE=""
RERIDER_SUPPORT_WHATSAPP=""

# Google Sheets Integration (Owner Operations Interface)
# Option A: Simple Google Apps Script Web App URL (no GCP project required)
GOOGLE_SHEETS_WEBAPP_URL=""

# Option B: Google Cloud Service Account
GOOGLE_SHEET_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# Inbound HMAC Webhook Secret (32+ character random string for verifying onEdit webhooks)
SHEETS_WEBHOOK_SECRET="change-this-to-a-secure-32-char-random-secret"




